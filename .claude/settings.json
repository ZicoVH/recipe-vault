{
  "permissions": {
    "allow": [
      "Bash(npm run lint)",
      "Bash(npm run format:check)",
      "Bash(npm run build)",
      "Bash(npm run check)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./package-lock.json)",
      "Read(./apps/*/dist/**)",
      "Read(./node_modules/**)",
      "Read(./apps/*/node_modules/**)",
      "Read(./.idea/**)"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/check-format.sh\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
